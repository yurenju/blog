---
import { buildLanguageLinks, LANGUAGE_NAMES, t, type Locale } from '../lib/i18n';

interface Props {
  currentLocale: Locale;
  pathname: string;
  isPostPage?: boolean;
  isWorkPage?: boolean;
  slug?: string;
  availableLocales?: Locale[];
}

const {
  currentLocale,
  pathname,
  isPostPage = false,
  isWorkPage = false,
  slug,
  availableLocales,
} = Astro.props;

const links = buildLanguageLinks({
  currentLocale,
  pathname,
  isPostPage,
  isWorkPage,
  slug,
  availableLocales,
});

const switchLabel = t(currentLocale).switchLanguage;
---
<details class="language-switcher">
  <summary aria-label={switchLabel} title={`${switchLabel}: ${LANGUAGE_NAMES[currentLocale]}`}>
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M3 5h10"/>
      <path d="M8 3v2"/>
      <path d="M5 8c0 6 5 8 7 8"/>
      <path d="M11 11c-1 4-4 6-8 7"/>
      <path d="M14 21l4-10 4 10"/>
      <path d="M15.5 17h5"/>
    </svg>
  </summary>
  <ul>
    {links.map((link) => (
      <li>
        <a href={link.href}>{LANGUAGE_NAMES[link.locale]}</a>
      </li>
    ))}
  </ul>
</details>

<style>
  .language-switcher {
    position: relative;
    font-size: 0.9rem;
  }
  summary {
    list-style: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.4rem;
    border-radius: 4px;
    color: var(--color-text-muted);
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover {
    background: var(--color-hover-bg);
    color: var(--color-text);
  }
  ul {
    position: absolute;
    right: 0;
    top: 100%;
    margin: 0.25rem 0 0 0;
    padding: 0.25rem 0;
    list-style: none;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    min-width: 8rem;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    z-index: 10;
  }
  li a {
    display: block;
    padding: 0.4rem 0.75rem;
    color: inherit;
    text-decoration: none;
  }
  li a:hover { background: var(--color-hover-bg); }
</style>
