---
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import { localePath, t, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  pathname: string;
  isPostPage?: boolean;
  isWorkPage?: boolean;
  slug?: string;
  availableLocales?: Locale[];
}

const {
  locale,
  pathname,
  isPostPage = false,
  isWorkPage = false,
  slug,
  availableLocales,
} = Astro.props;

const text = t(locale);
---
<header class="site-header">
  <div class="inner">
    <a href={localePath(locale)} class="brand">Yuren's Blog</a>
    <div class="right">
      <nav>
        <a href={localePath(locale, 'about')}>{text.nav.about}</a>
        <a href={localePath(locale, 'subscription')}>{text.nav.subscription}</a>
      </nav>
      <div class="tools">
        <LanguageSwitcher
          currentLocale={locale}
          pathname={pathname}
          isPostPage={isPostPage}
          isWorkPage={isWorkPage}
          slug={slug}
          availableLocales={availableLocales}
        />
        <ThemeToggle locale={locale} />
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
  }
  .inner {
    max-width: 48rem;
    margin: 0 auto;
    padding: 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .brand {
    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1;
  }
  .right {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  nav {
    display: flex;
    gap: 1.25rem;
    font-size: 0.95rem;
  }
  .tools {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }
  @media (max-width: 480px) {
    .inner { padding: 0.85rem 1rem; gap: 0.6rem; }
    .brand { font-size: 1.15rem; }
    .right { gap: 0.6rem; }
    nav { gap: 0.85rem; font-size: 0.85rem; }
  }
</style>
