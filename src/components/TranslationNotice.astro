---
import { t, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  slug: string;
}

const { locale, slug } = Astro.props;
const notice = t(locale).post.translationNotice;
const originalHref = `/zh/posts/${slug}`;
---
{notice && (
  <p class="translation-notice">
    {notice.prefix}<a href={originalHref}>{notice.linkText}</a>{notice.suffix}
  </p>
)}

<style>
  .translation-notice {
    border-top: 1px solid var(--color-border);
    margin: 3rem 0 0 0;
    padding-top: 1.5rem;
    text-align: center;
    font-family: var(--font-serif), 'Times New Roman', serif;
    font-style: italic;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }
  .translation-notice a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
