---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="inner">
    <p>© {year} Yuren Ju</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    margin-top: 4rem;
  }
  .inner {
    max-width: 48rem;
    margin: 0 auto;
    padding: 1.5rem 1rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    text-align: center;
  }
</style>
