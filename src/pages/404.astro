---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="404 · Yuren's Blog"
  lang="zh-Hant-TW"
  canonical={new URL('/404', Astro.site ?? 'https://yurenju.blog')}
  ogLocale="zh-Hant-TW"
>
  <main class="container not-found">
    <h1>404</h1>
    <p>找不到這個頁面 · Page not found · ページが見つかりません</p>
    <p>
      <a href="/zh/">回到首頁</a> ·
      <a href="/ja/">ホームへ</a> ·
      <a href="/en/">Home</a>
    </p>
  </main>
</BaseLayout>

<style>
  .not-found {
    text-align: center;
    padding: 6rem 1rem;
  }
  .not-found h1 {
    font-size: 5rem;
    margin-bottom: 1rem;
    color: var(--color-text-muted);
  }
  .not-found p {
    margin: 0.5rem 0;
  }
  .not-found a {
    color: var(--color-link);
  }
</style>
