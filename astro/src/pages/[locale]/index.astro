---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PostList from '../../components/PostList.astro';
import LanguageNotice from '../../components/LanguageNotice.astro';
import { getActivePosts } from '../../lib/posts';
import { LOCALES, type Locale, t } from '../../lib/i18n';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const posts = await getActivePosts(locale);
const heading = t(locale).nav.home;
---
<BaseLayout title="Yuren's Blog" lang={locale}>
  <Header locale={locale} pathname={Astro.url.pathname} />
  <main class="container">
    <h1 class="page-title">{heading}</h1>
    {locale !== 'zh' && <LanguageNotice locale={locale} postCount={posts.length} />}
    <PostList locale={locale} posts={posts} />
  </main>
  <Footer />
</BaseLayout>

<style>
  .page-title {
    font-size: 2.25rem;
    margin-bottom: 2rem;
  }
</style>
