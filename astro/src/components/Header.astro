---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { localePath, t, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  pathname: string;
  isPostPage?: boolean;
  slug?: string;
  availableLocales?: Locale[];
}

const {
  locale,
  pathname,
  isPostPage = false,
  slug,
  availableLocales,
} = Astro.props;

const text = t(locale);
const showArchives = locale === 'zh';
---
<header class="site-header">
  <div class="inner">
    <a href={localePath(locale)} class="brand">Yuren's Blog</a>
    <nav>
      <a href={localePath(locale, 'tech')}>{text.nav.tech}</a>
      <a href={localePath(locale, 'life')}>{text.nav.life}</a>
      {showArchives && <a href={localePath(locale, 'archives')}>{text.nav.archives}</a>}
      <a href={localePath(locale, 'about')}>{text.nav.about}</a>
    </nav>
    <LanguageSwitcher
      currentLocale={locale}
      pathname={pathname}
      isPostPage={isPostPage}
      slug={slug}
      availableLocales={availableLocales}
    />
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
  }
  .inner {
    max-width: 48rem;
    margin: 0 auto;
    padding: 1rem;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .brand {
    font-family: var(--font-serif), serif;
    font-size: 1.25rem;
    font-weight: 700;
  }
  nav {
    display: flex;
    gap: 1.25rem;
    font-size: 0.95rem;
  }
</style>
