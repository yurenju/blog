---
import { buildLanguageLinks, LANGUAGE_NAMES, t, type Locale } from '../lib/i18n';

interface Props {
  currentLocale: Locale;
  pathname: string;
  isPostPage?: boolean;
  slug?: string;
  availableLocales?: Locale[];
}

const {
  currentLocale,
  pathname,
  isPostPage = false,
  slug,
  availableLocales,
} = Astro.props;

const links = buildLanguageLinks({
  currentLocale,
  pathname,
  isPostPage,
  slug,
  availableLocales,
});

const switchLabel = t(currentLocale).switchLanguage;
---
<details class="language-switcher">
  <summary aria-label={switchLabel}>
    <span aria-hidden="true">🌐</span>
    <span class="current">{LANGUAGE_NAMES[currentLocale]}</span>
  </summary>
  <ul>
    {links.map((link) => (
      <li>
        <a href={link.href}>{LANGUAGE_NAMES[link.locale]}</a>
      </li>
    ))}
  </ul>
</details>

<style>
  .language-switcher {
    position: relative;
    font-size: 0.9rem;
  }
  summary {
    list-style: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover { background: #f3f3f3; }
  ul {
    position: absolute;
    right: 0;
    top: 100%;
    margin: 0.25rem 0 0 0;
    padding: 0.25rem 0;
    list-style: none;
    background: #fff;
    border: 1px solid #e5e5e5;
    border-radius: 4px;
    min-width: 8rem;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    z-index: 10;
  }
  li a {
    display: block;
    padding: 0.4rem 0.75rem;
    color: inherit;
    text-decoration: none;
  }
  li a:hover { background: #f3f3f3; }
</style>
