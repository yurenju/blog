---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PostMeta from '../components/PostMeta.astro';
import type { PostMeta as PostMetaType } from '../lib/posts';
import type { Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  post: PostMetaType;
  availableLocales?: Locale[];
}

const { locale, post, availableLocales } = Astro.props;
const pageTitle = `${post.title} · Yuren's Blog`;
---
<BaseLayout title={pageTitle} description={post.description}>
  <Header
    locale={locale}
    pathname={Astro.url.pathname}
    isPostPage={true}
    slug={post.slug}
    availableLocales={availableLocales}
  />
  <main class="container">
    <article>
      <header class="post-head">
        <h1>{post.title}</h1>
        <PostMeta date={post.date} category={post.category} />
      </header>
      <div class="prose">
        <slot />
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>

<style>
  .post-head {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid #eee;
  }
  .post-head h1 {
    font-size: 2.25rem;
    margin-bottom: 0.75rem;
  }
</style>
